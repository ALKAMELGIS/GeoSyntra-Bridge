  "label_rules": [
    {
      "field": "DIAMETER",
      "pattern": "(?:DN|Ø|⌀|%%C|DIA\\.?|D\\s*=)\\s*(?P<v>\\d{2,4})(?:\\s*MM)?\\b|\\b(?P<v2>\\d{2,4})\\s*MM\\b",
      "value_type": "int",
      "targets": [
        "IrrigationMainline",
        "IrrigationLateral",
        "IrrigationValve"
      ]
    },
    {
      "field": "DIAMETER",
      "pattern": "\\b(?:Ø|PE|HDPE)?\\s*(?P<v>\\d{2,3})\\s*(?:MM|Ø)\\b",
      "value_type": "int",
      "targets": [
        "IrrigationLateral"
      ]
    },
    {
      "field": "MATERIAL",
      "pattern": "\\b(?P<v>UPVC|HDPE|PVC|GRP|RCP|PE|DI|ST|CI|AC|VC|CU)\\b",
      "targets": [
        "IrrigationMainline",
        "IrrigationLateral"
      ],
      "value_type": "upper",
      "description": "pipe material code in label"
    },
    {
      "field": "LENGTH",
      "pattern": "\\bL\\s*[=:]\\s*(?P<v>\\d+(?:\\.\\d+)?)\\s*M?\\b",
      "value_type": "float",
      "targets": [
        "IrrigationMainline",
        "IrrigationLateral"
      ]
    },
    {
      "field": "WATER_SOURCE",
      "pattern": "\\b(?P<v>TSE|POT|MIX|GW)\\b",
      "value_type": "upper",
      "targets": [
        "IrrigationMainline",
        "IrrigationLateral",
        "IrrigationTank"
      ]
    },
    {
      "field": "VALVE_ID",
      "pattern": "\\b(?P<v>(?:SV|IV|QCV|ARV)[-_]?\\d{1,5})\\b",
      "value_type": "upper",
      "targets": [
        "IrrigationValve"
      ]
    },
    {
      "field": "ZONE_NO",
      "pattern": "\\bZ(?:ONE)?\\s*[-_#]?\\s*(?P<v>\\d{1,4}[A-Z]?)\\b",
      "value_type": "upper",
      "targets": [
        "IrrigationValve",
        "IrrigationZone"
      ]
    },
    {
      "field": "CONTROLLER_ID",
      "pattern": "\\b(?:CONTROLLER|CTRL|CLR)\\s*[-_#]?\\s*(?P<v>[A-Z]?\\d{1,3})\\b",
      "value_type": "upper",
      "targets": [
        "IrrigationController"
      ]
    },
    {
      "field": "STATIONS",
      "pattern": "\\b(?P<v>\\d{1,3})\\s*(?:ST|STN|STATIONS?)\\b",
      "value_type": "int",
      "targets": [
        "IrrigationController"
      ]
    }
  ],
  "label_search_radius": 4.0,
  "network": {
    "enabled": true,
    "flow": "pressure",
    "edges": [
      "IrrigationMainline",
      "IrrigationLateral"
    ],
    "junctions": [
      "IrrigationValve",
      "IrrigationTank"
    ],
    "snap_tolerance": 0.1,
    "upstream_node_field": "FROM_NODE",
    "downstream_node_field": "TO_NODE"
  },
  "relationships": [],
  "validation": {
    "min_line_length": 0.05,
    "min_polygon_area": 0.1,
    "duplicate_tolerance": 0.001,
    "unique_fields": {
