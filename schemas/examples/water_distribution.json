  "label_rules": [
    {
      "field": "DIAMETER",
      "pattern": "(?:DN|Ø|⌀|%%C|DIA\\.?|D\\s*=)\\s*(?P<v>\\d{2,4})(?:\\s*MM)?\\b|\\b(?P<v2>\\d{2,4})\\s*MM\\b",
      "value_type": "int",
      "targets": [
        "WaterMain",
        "Valve",
        "Hydrant",
        "Fitting"
      ]
    },
    {
      "field": "MATERIAL",
      "pattern": "\\b(?P<v>UPVC|HDPE|PVC|GRP|RCP|PE|DI|ST|CI|AC|VC|CU)\\b",
      "targets": [
        "WaterMain"
      ],
      "value_type": "upper",
      "description": "pipe material code in label"
    },
    {
      "field": "LENGTH",
      "pattern": "\\bL\\s*[=:]\\s*(?P<v>\\d+(?:\\.\\d+)?)\\s*M?\\b",
      "value_type": "float",
      "targets": [
        "WaterMain"
      ]
    },
    {
      "field": "PN_RATING",
      "pattern": "\\bPN\\s*(?P<v>\\d{1,2})\\b",
      "value_type": "int",
      "targets": [
        "WaterMain"
      ]
    },
    {
      "field": "PIPE_ID",
      "pattern": "\\b(?P<v>WM[-_]?\\d{1,6})\\b",
      "value_type": "upper",
      "targets": [
        "WaterMain"
      ]
    },
    {
      "field": "VALVE_ID",
      "pattern": "\\b(?P<v>(?:GV|BFV|AV|WO|PRV|V)[-_]?\\d{1,6})\\b",
      "value_type": "upper",
      "targets": [
        "Valve"
      ]
    },
    {
      "field": "HYDRANT_ID",
      "pattern": "\\b(?P<v>(?:FH|HYD)[-_]?\\d{1,6})\\b",
      "value_type": "upper",
      "targets": [
        "Hydrant"
      ]
    },
    {
      "field": "ELEVATION",
      "pattern": "\\b(?:EL|ELEV|RL)\\s*[=:]?\\s*(?P<v>-?\\d+\\.\\d+)",
      "value_type": "float",
      "targets": [
        "Valve",
        "Hydrant"
      ]
    }
  ],
  "label_search_radius": 6.0,
