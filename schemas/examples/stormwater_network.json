  "label_rules": [
    {
      "field": "DIAMETER",
      "pattern": "(?:DN|Ø|⌀|%%C|DIA\\.?|D\\s*=)\\s*(?P<v>\\d{2,4})(?:\\s*MM)?\\b|\\b(?P<v2>\\d{2,4})\\s*MM\\b",
      "value_type": "int",
      "targets": [
        "StormPipe"
      ]
    },
    {
      "field": "MATERIAL",
      "pattern": "\\b(?P<v>UPVC|HDPE|PVC|GRP|RCP|PE|DI|ST|CI|AC|VC|CU)\\b",
      "targets": [
        "StormPipe"
      ],
      "value_type": "upper",
      "description": "pipe material code in label"
    },
    {
      "field": "LENGTH",
      "pattern": "\\bL\\s*[=:]\\s*(?P<v>\\d+(?:\\.\\d+)?)\\s*M?\\b",
      "value_type": "float",
      "targets": [
        "StormPipe"
      ]
    },
    {
      "field": "SLOPE_PCT",
      "pattern": "\\b(?:S|SLOPE|GR)\\s*[=:]?\\s*(?P<v>\\d+(?:\\.\\d+)?)\\s*%",
      "value_type": "float",
      "targets": [
        "StormPipe"
      ]
    },
    {
      "field": "US_IL",
      "pattern": "\\b(?:US|U/S|UP)\\s*\\.?\\s*IL\\s*[=:]?\\s*(?P<v>-?\\d+\\.\\d+)",
      "value_type": "float",
      "targets": [
        "StormPipe"
      ],
      "priority": 5
    },
    {
      "field": "DS_IL",
      "pattern": "\\b(?:DS|D/S|DN)\\s*\\.?\\s*IL\\s*[=:]?\\s*(?P<v>-?\\d+\\.\\d+)",
      "value_type": "float",
      "targets": [
        "StormPipe"
      ],
      "priority": 5
    },
    {
      "field": "PIPE_ID",
      "pattern": "\\b(?P<v>(?:SD|STP|SW)[-_]?\\d{1,6})\\b",
      "value_type": "upper",
      "targets": [
        "StormPipe"
      ]
    },
    {
      "field": "MH_ID",
      "pattern": "\\b(?P<v>(?:SDMH|SMH|DMH|MH|D)[-_ ]?\\d{1,6}[A-Z]?)\\b",
      "value_type": "upper",
      "targets": [
        "StormManhole"
      ]
    },
    {
      "field": "COVER_LEVEL",
      "pattern": "\\b(?:CL|C\\.L\\.|COVER\\s*LEVEL|RL|TL)\\s*[=:]?\\s*(?P<v>-?\\d+\\.\\d+)",
      "value_type": "float",
      "targets": [
        "StormManhole"
      ]
    },
    {
      "field": "INVERT_LEVEL",
      "pattern": "\\b(?:IL|I\\.L\\.|INV(?:ERT)?\\s*(?:LEVEL)?)\\s*[=:]?\\s*(?P<v>-?\\d+\\.\\d+)",
      "value_type": "float",
      "targets": [
        "StormManhole"
      ]
    },
    {
      "field": "DEPTH",
      "pattern": "\\b(?:DEPTH|D)\\s*[=:]\\s*(?P<v>\\d+(?:\\.\\d+)?)\\s*M?\\b",
      "value_type": "float",
      "targets": [
        "StormManhole"
      ]
    }
  ],
  "label_search_radius": 6.0,
  "network": {
    "enabled": true,
    "flow": "gravity",
    "edges": [
      "StormPipe"
    ],
    "junctions": [
      "StormManhole",
