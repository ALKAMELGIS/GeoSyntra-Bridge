  "label_rules": [
    {
      "field": "POLE_ID",
      "pattern": "\\b(?P<v>(?:LP|SL|P)[-_]?\\d{1,6}[A-Z]?)\\b",
      "value_type": "upper",
      "targets": [
        "LightPole"
      ]
    },
    {
      "field": "FP_ID",
      "pattern": "\\b(?P<v>FP[-_]?\\d{1,5})\\b",
      "value_type": "upper",
      "targets": [
        "FeederPillar",
        "LightPole"
      ]
    },
    {
      "field": "POLE_HEIGHT",
      "pattern": "\\b(?:H|HT)\\s*[=:]?\\s*(?P<v>\\d{1,2}(?:\\.\\d+)?)\\s*M\\b",
      "value_type": "float",
      "targets": [
        "LightPole"
      ]
    },
    {
      "field": "WATTAGE",
      "pattern": "\\b(?P<v>\\d{2,4})\\s*W\\b",
      "value_type": "int",
      "targets": [
        "LightPole"
      ]
    },
    {
      "field": "LUMINAIRE",
      "pattern": "\\b(?P<v>LED|HPS|MH)\\b",
      "value_type": "upper",
      "targets": [
        "LightPole"
      ]
    },
    {
      "field": "CABLE_SIZE",
      "pattern": "\\b(?P<v>\\d\\s*[Cx×]\\s*\\d{1,3}(?:\\.\\d)?\\s*(?:SQ\\.?\\s*MM|MM2|MM²))",
      "value_type": "upper",
      "targets": [
        "LVCable"
      ]
    },
    {
      "field": "CIRCUIT_NO",
      "pattern": "\\b(?:CCT|CIRCUIT|C)\\s*[-_#]?\\s*(?P<v>\\d{1,3}[A-Z]?)\\b",
      "value_type": "upper",
      "targets": [
        "LVCable",
        "LightPole"
      ]
    },
    {
      "field": "LENGTH",
      "pattern": "\\bL\\s*[=:]\\s*(?P<v>\\d+(?:\\.\\d+)?)\\s*M?\\b",
      "value_type": "float",
      "targets": [
        "LVCable"
      ]
    }
  ],
  "label_search_radius": 5.0,
  "network": {
    "enabled": true,
    "flow": "none",
    "edges": [
      "LVCable"
    ],
    "junctions": [
      "LightPole",
      "FeederPillar",
      "HandHole"
    ],
    "snap_tolerance": 0.25,
    "upstream_node_field": "FROM_NODE",
    "downstream_node_field": "TO_NODE"
  },
  "relationships": [
    {
      "name": "FeederPillar_LightPole",
      "origin": "FeederPillar",
      "destination": "LightPole",
      "origin_primary_key": "FP_ID",
      "origin_foreign_key": "FP_ID",
      "cardinality": "one_to_many",
      "forward_label": "Poles",
      "backward_label": "Feeder pillar"
    }
  ],
  "validation": {
    "min_line_length": 0.05,
    "min_polygon_area": 0.1,
    "duplicate_tolerance": 0.001,
    "unique_fields": {
      "LightPole": [
        "POLE_ID"
      ],
      "FeederPillar": [
        "FP_ID"
      ]
    }
  },
  "repair": {
    "remove_duplicate_vertices": true,
    "close_near_closed_rings": true,
    "ring_closure_tolerance": 0.05,
    "make_valid_polygons": true,
    "snap_line_endpoints": true
  }
