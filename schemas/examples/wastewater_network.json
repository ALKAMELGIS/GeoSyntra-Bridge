  "label_rules": [
    {
      "field": "DIAMETER",
      "pattern": "(?:DN|Ø|⌀|%%C|DIA\\.?|D\\s*=)\\s*(?P<v>\\d{2,4})(?:\\s*MM)?\\b|\\b(?P<v2>\\d{2,4})\\s*MM\\b",
      "value_type": "int",
      "targets": [
        "GravitySewer"
      ]
    },
    {
      "field": "MATERIAL",
      "pattern": "\\b(?P<v>UPVC|HDPE|PVC|GRP|RCP|PE|DI|ST|CI|AC|VC|CU)\\b",
      "targets": [
        "GravitySewer"
      ],
      "value_type": "upper",
      "description": "pipe material code in label"
    },
    {
      "field": "LENGTH",
      "pattern": "\\bL\\s*[=:]\\s*(?P<v>\\d+(?:\\.\\d+)?)\\s*M?\\b",
      "value_type": "float",
      "targets": [
        "GravitySewer"
      ]
    },
    {
      "field": "SLOPE_PCT",
      "pattern": "\\b(?:S|SLOPE|GR)\\s*[=:]?\\s*(?P<v>\\d+(?:\\.\\d+)?)\\s*%",
      "value_type": "float",
      "targets": [
        "GravitySewer"
      ]
    },
    {
      "field": "US_IL",
      "pattern": "\\b(?:US|U/S|UP)\\s*\\.?\\s*IL\\s*[=:]?\\s*(?P<v>-?\\d+\\.\\d+)",
      "value_type": "float",
      "targets": [
        "GravitySewer"
      ],
      "priority": 5
    },
    {
      "field": "DS_IL",
      "pattern": "\\b(?:DS|D/S|DN)\\s*\\.?\\s*IL\\s*[=:]?\\s*(?P<v>-?\\d+\\.\\d+)",
      "value_type": "float",
      "targets": [
        "GravitySewer"
      ],
      "priority": 5
    },
    {
      "field": "PIPE_ID",
      "pattern": "\\b(?P<v>(?:SP|SW|GS)[-_]?\\d{1,6})\\b",
      "value_type": "upper",
      "targets": [
        "GravitySewer"
      ]
    },
    {
      "field": "MH_ID",
      "pattern": "\\b(?P<v>(?:SMH|MH|S)[-_ ]?\\d{1,6}[A-Z]?)\\b",
      "value_type": "upper",
      "targets": [
        "SewerManhole"
      ]
    },
    {
      "field": "COVER_LEVEL",
      "pattern": "\\b(?:CL|C\\.L\\.|COVER\\s*LEVEL|RL|TL)\\s*[=:]?\\s*(?P<v>-?\\d+\\.\\d+)",
      "value_type": "float",
      "targets": [
        "SewerManhole"
      ]
    },
    {
      "field": "INVERT_LEVEL",
      "pattern": "\\b(?:IL|I\\.L\\.|INV(?:ERT)?\\s*(?:LEVEL)?)\\s*[=:]?\\s*(?P<v>-?\\d+\\.\\d+)",
      "value_type": "float",
      "targets": [
        "SewerManhole"
      ]
    },
    {
      "field": "DEPTH",
      "pattern": "\\b(?:DEPTH|D)\\s*[=:]\\s*(?P<v>\\d+(?:\\.\\d+)?)\\s*M?\\b",
      "value_type": "float",
      "targets": [
        "SewerManhole"
      ]
    }
  ],
  "label_search_radius": 6.0,
  "network": {
    "enabled": true,
    "flow": "gravity",
    "edges": [
